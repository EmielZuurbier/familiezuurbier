# Voorbeelden verschijnen alleen zolang er geen personen in de database staan.
# Zonder database-instellingen zijn uitsluitend fictieve voorbeelden zichtbaar.
# Stel de database in volgens README.md; eigen gegevens vereisen altijd inloggen.
DATABASE_URL=postgresql://familieboom:VERVANG_DIT@127.0.0.1:54329/familieboom
POSTGRES_PASSWORD=VERVANG_DIT
PAYLOAD_SECRET=
# Opgeslagen familiegegevens zijn uitsluitend zichtbaar na inloggen.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Publiek Mapbox-token voor de kaart. Gebruik hier uitsluitend een pk.-token.
MAPBOX_ACCESS_TOKEN=
# Websiteadres voor persoonlijke uitnodigingen. Gebruik HTTPS buiten lokale ontwikkeling.
FAMILY_APP_URL=http://localhost:3000
# Sluit een e-maildienst aan om uitnodigingen en codes echt te versturen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Alleen true als een eigen, vertrouwde proxy de doorgegeven clientadressen beheert.
FAMILY_TRUST_PROXY=false
